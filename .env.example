# Supabase (Project Settings → API). URL e chave publicável podem ir ao navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# URL pública do site (links dos e-mails de confirmação/recuperação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SOMENTE NO SERVIDOR. Nunca prefixe com NEXT_PUBLIC_ e nunca envie ao repositório.
SUPABASE_SERVICE_ROLE_KEY=

# Tarefa agendada (/api/cron): manutenção de assinaturas, lembretes e envios.
# Gere um valor aleatório longo. A Vercel envia automaticamente como Bearer.
CRON_SECRET=

# E-mail transacional (Resend). Sem isso, os e-mails ficam como "não configurado".
RESEND_API_KEY=
EMAIL_FROM="Agendas Pro <avisos@seudominio.com.br>"

# WhatsApp por provedor HTTP (Z-API, Evolution API...). Recebe POST { phone, message }.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# As chaves dos gateways (Mercado Pago, Asaas, Stripe) NÃO ficam aqui:
# cadastre-as em /super-admin/gateways (vão para o cofre criptografado do Supabase).
